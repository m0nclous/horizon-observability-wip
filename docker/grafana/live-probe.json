{
  "description": "e2e fixture of the live modes (Addendum R4.8, T12): the poll and stream panel shapes of the R4.8 panel JSON, built by hand, independent of the T13 renderer. Datasources: Prometheus uid 'prometheus', Infinity uid 'horizon-observability-api' (docker/grafana/provisioning), Grafana Live stream id 'horizon_observability'.",
  "uid": "horizon-observability-live-probe",
  "title": "Horizon Observability live probe",
  "tags": [
    "horizon-observability",
    "e2e"
  ],
  "editable": false,
  "graphTooltip": 0,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "timezone": "utc",
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.3.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "yesoreyeram-infinity-datasource",
      "name": "Infinity",
      "version": "4.1.1"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "options": []
      },
      {
        "name": "app_api",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "hide": 2,
        "current": {
          "selected": true,
          "text": "Horizon Observability API",
          "value": "horizon-observability-api"
        },
        "options": []
      },
      {
        "name": "api_path",
        "type": "constant",
        "query": "/horizon/observability",
        "hide": 2
      },
      {
        "name": "scrape_interval",
        "type": "constant",
        "query": "10s",
        "hide": 2
      },
      {
        "name": "supervisor",
        "type": "custom",
