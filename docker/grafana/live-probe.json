        },
        "options": [],
        "skipUrlSync": false
      },
      {
        "name": "batch_kind",
        "type": "custom",
        "label": "batch_kind",
        "query": "",
        "includeAll": true,
        "multi": true,
        "hide": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "skipUrlSync": false
      },
      {
        "name": "queue",
        "type": "custom",
        "label": "queue",
        "query": "",
        "includeAll": true,
        "multi": true,
        "hide": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "skipUrlSync": false
      },
      {
