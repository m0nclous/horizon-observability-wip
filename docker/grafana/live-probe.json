  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Poll (Infinity, ${api_path}/live)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Supervisor Processes",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${app_api}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "—",
                  "color": "text",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true,
        "text": {
          "titleSize": 14
        }
      },
      "targets": [
        {
          "refId": "S",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${app_api}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "${api_path}/live?${supervisor:queryparam}&${batch_kind:queryparam}&${queue:queryparam}&${job_class:queryparam}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "tiles",
          "columns": [
            {
              "selector": "tile",
              "text": "tile",
              "type": "string"
            },
            {
              "selector": "key",
              "text": "key",
              "type": "string"
            },
            {
              "selector": "caption",
              "text": "caption",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            },
            {
              "selector": "color",
              "text": "color",
              "type": "string"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "tile",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": "supervisor"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "tile": {
                "operation": "groupby"
              },
              "key": {
                "operation": "groupby"
              },
              "caption": {
                "operation": "aggregate",
                "aggregations": [
                  "last"
                ]
              },
              "value": {
                "operation": "aggregate",
                "aggregations": [
                  "last"
                ]
              },
              "color": {
                "operation": "aggregate",
                "aggregations": [
                  "last"
                ]
              }
            }
          }
        },
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "caption (last)",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "value (last)",
                "handlerKey": "field.value"
              },
              {
                "fieldName": "color (last)",
                "handlerKey": "color"
              },
              {
                "fieldName": "tile",
                "handlerKey": "__ignore"
              },
              {
                "fieldName": "key",
                "handlerKey": "__ignore"
              }
            ]
          }
        }
      ]
    },
