{
    "name": "sushi-market/horizon-observability",
    "description": "Prometheus metrics, live job lists, a Grafana dashboard and alert rules for Laravel Horizon and its Redis queues.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "horizon",
        "queue",
        "redis",
        "prometheus",
        "grafana",
        "metrics",
        "monitoring",
        "observability"
    ],
    "homepage": "https://github.com/sushi-market/horizon-observability",
    "support": {
        "issues": "https://github.com/sushi-market/horizon-observability/issues",
        "source": "https://github.com/sushi-market/horizon-observability"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.23 || ^12.0 || ^13.0",
        "laravel/horizon": "^5.29.1"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.1",
        "ergebnis/composer-normalize": "^2.45",
        "larastan/larastan": "^3.1",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.5 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "predis/predis": "^2.0.2 || ^3.0",
        "rector/rector": "^2.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "suggest": {
        "ext-redis": "Recommended Redis client (phpredis).",
        "predis/predis": "Pure-PHP Redis client, supported as an alternative (^2.0.2 || ^3.0)."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "DF\\HorizonObservability\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DF\\HorizonObservability\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "DF\\HorizonObservability\\HorizonObservabilityServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "horizon": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench horizon --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --parallel --ansi",
            "@php vendor/bin/rector --ansi"
        ],
        "load": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench workbench:simulate-load --continuous --ansi"
        ],
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --host=0.0.0.0 --port=8000 --ansi"
        ],
        "test": [
            "@test:lint",
            "@test:types",
            "@php vendor/bin/pest --exclude-group=cluster,e2e"
        ],
        "test:grafana": "@php vendor/bin/testbench horizon-observability:grafana resources/grafana --defaults --check --ansi",
        "test:lint": [
            "@php vendor/bin/pint --test --ansi",
            "@php vendor/bin/rector --dry-run --ansi"
        ],
        "test:predis": "REDIS_CLIENT=predis vendor/bin/pest --group=redis",
        "test:redis": "@php vendor/bin/pest --group=redis",
        "test:types": "@php vendor/bin/phpstan analyse --memory-limit=1G --ansi",
        "test:unit": "@php vendor/bin/pest --exclude-group=redis,cluster,e2e"
    }
}
