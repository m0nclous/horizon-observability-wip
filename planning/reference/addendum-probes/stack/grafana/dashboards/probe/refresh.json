{
  "uid": "probe-refresh",
  "title": "Refresh probe 1s",
  "tags": [
    "probe"
  ],
  "schemaVersion": 42,
  "refresh": "1s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "15s",
      "30s"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": true
      },
      {
        "name": "scrape_interval",
        "type": "constant",
        "query": "10s",
        "hide": 2,
        "skipUrlSync": true,
        "current": {
          "text": "10s",
          "value": "10s"
        },
        "options": [
          {
            "text": "10s",
            "value": "10s",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 501,
      "type": "stat",
      "title": "P501 range-only (incremental eligible)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(office_queue_pending_jobs)",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 502,
      "type": "stat",
      "title": "P502 interval=$scrape_interval",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rate(office_queue_jobs_total[$__rate_interval]))",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "interval": "$scrape_interval"
    },
    {
      "id": 503,
      "type": "stat",
      "title": "P503 interval=30s literal",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rate(office_queue_jobs_total[$__rate_interval]))",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "interval": "30s"
    }
  ],
  "annotations": {
    "list": []
  }
}