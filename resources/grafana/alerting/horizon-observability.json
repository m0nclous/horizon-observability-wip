{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Queues",
      "folder": "Horizon",
      "interval": "1m",
      "rules": [
        {
          "uid": "horizon-observability-no-metrics",
          "title": "No queue metrics",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${HORIZON_OBSERVABILITY_PROMETHEUS_UID}",
              "model": {
                "editorMode": "code",
                "expr": "count(max by (job) (ho_horizon_status{job=~\".+\"}))",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Prometheus has no ho_horizon_status: the metrics endpoint of the application is not scraped",
            "__dashboardUid__": "horizon-observability",
            "__panelId__": "1"
          },
          "isPaused": false
        },
        {
          "uid": "horizon-observability-down",
          "title": "Horizon is down",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${HORIZON_OBSERVABILITY_PROMETHEUS_UID}",
              "model": {
                "editorMode": "code",
                "expr": "min by (job) (max by (job) (ho_horizon_status{job=~\".+\"}))",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Horizon is paused or not running ({{ $labels.job }})",
            "__dashboardUid__": "horizon-observability",
            "__panelId__": "1"
          },
          "isPaused": false
        },
        {
          "uid": "horizon-observability-long-wait",
          "title": "Queue wait over 2x limit",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${HORIZON_OBSERVABILITY_PROMETHEUS_UID}",
              "model": {
                "editorMode": "code",
                "expr": "max by (job, queue) (max by (job, connection, queue) (ho_queue_oldest_pending_job_age_seconds{job=~\".+\"})) / on (job, queue) max by (job, queue) (max by (job, connection, queue) (ho_horizon_wait_threshold_seconds{job=~\".+\"}))",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        2
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "{{ with $values.A }}Oldest pending job in {{ $labels.queue }} ({{ $labels.job }}) waits {{ printf \"%.1f\" .Value }}x the queue wait limit{{ else }}No wait data for {{ $labels.queue }} ({{ $labels.job }}){{ end }}",
            "__dashboardUid__": "horizon-observability",
            "__panelId__": "2"
          },
          "isPaused": false
        },
        {
          "uid": "horizon-observability-failures",
          "title": "High failure rate",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 900,
                "to": 0
              },
              "datasourceUid": "${HORIZON_OBSERVABILITY_PROMETHEUS_UID}",
              "model": {
                "editorMode": "code",
                "expr": "sum by (job, queue) (max by (job, connection, queue, job_class, status) (increase(ho_queue_jobs_total{job=~\".+\", status=~\"failed|timed_out\"}[15m]))) / clamp_min(sum by (job, queue) (max by (job, connection, queue, job_class, status) (increase(ho_queue_jobs_total{job=~\".+\", status=~\"completed|failed|timed_out\"}[15m]))), 100)",
                "instant": true,
                "range": false,
                "refId": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gte",
                      "params": [
                        0.05
                      ]
                    }
                  }
                ],
                "refId": "C"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "{{ with $values.A }}{{ humanizePercentage .Value }} of attempts in {{ $labels.queue }} ({{ $labels.job }}) failed in 15 minutes{{ else }}No attempt data for {{ $labels.queue }} ({{ $labels.job }}){{ end }}",
            "__dashboardUid__": "horizon-observability",
            "__panelId__": "4"
          },
          "isPaused": false
        }
      ]
    }
  ],
  "deleteRules": [
    {
      "orgId": 1,
      "uid": "horizon-observability-live"
    },
    {
      "orgId": 1,
      "uid": "horizon-observability-collector"
    },
    {
      "orgId": 1,
      "uid": "horizon-observability-duplicates"
    }
  ]
}
