{
    "name": "sushi-market/horizon-prometheus-grafana",
    "description": "Метрики Horizon и очередей для Prometheus, дашборд Grafana «Queues» с алертами, звуком и речью",
    "type": "library",
    "version": "1.0.0",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.40",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-prometheus": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "SushiMarket\\HorizonPrometheusGrafana\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SushiMarket\\HorizonPrometheusGrafana\\HorizonPrometheusGrafanaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
